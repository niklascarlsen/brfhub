{
  "name": "booking-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite --host",
    "prebuild": "npm run generate",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate": "node scripts/generate-theme.mjs && node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "precheck": "npm run generate",
    "check": "prettier --check . && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@booking/core": "*",
    "@fontsource-variable/merriweather": "^5.3.0",
    "better-auth": "^1.7.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "ionicons": "^8.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
