# iOS Simulator / web
EXPO_PUBLIC_API_URL=http://localhost:3000

# Android emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Physical device
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Physical iPhone: the Apple team that signs the build. A paid Apple
# Developer Program team signs push; a free Apple ID's personal team cannot.
# APPLE_TEAM_ID=
# APPLE_PERSONAL_TEAM=
