# Copy to deploy/.env and fill in. Back the file up with the database:
# BETTER_AUTH_SECRET encrypts every admin's authenticator.

# The host name Caddy gets a certificate for, and the address people open.
DOMAIN=brfhub.example.se
PUBLIC_URL=https://brfhub.example.se

# openssl rand -base64 32, for each.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Any SMTP service, from a domain with SPF and DKIM set up.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=BrfHub <brfhub@example.se>

# npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.se
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
