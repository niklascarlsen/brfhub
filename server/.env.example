DATABASE_URL=postgresql://postgres:postgres@localhost:5433/booking
HOST=0.0.0.0
PORT=3000
# Web push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# production turns on Better Auth's rate limiting and makes the settings
# below mandatory. Leave unset in dev.
# NODE_ENV=production
# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Web client origin, allowed to send cookies. Required in production, unset
# allows every origin in dev. The session cookie is SameSite, so this and
# the API have to share a site (boka.x.se and api.x.se, not two hosts on
# a shared platform domain).
# WEB_ORIGIN=https://boka.example.se
