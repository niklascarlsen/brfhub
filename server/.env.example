DATABASE_URL=postgresql://postgres:postgres@localhost:5433/booking
HOST=0.0.0.0
PORT=3000
# Web push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Production is the default: it turns on rate limiting, hides /docs and
# makes the settings marked required below mandatory. The npm scripts set
# development (dev, db:seed, types:gen) and test (test) themselves, so
# leave it unset here.
# NODE_ENV=production
# Dev signs in without a mailbox or an authenticator: every mailed code is
# 123456 and the login screens fill the codes in. off tests the real flow:
# the codes are random, read in Mailpit and from an authenticator app.
# DEV_SIGN_IN=off
# Better Auth. Generate the secret with: openssl rand -base64 32. Required
# everywhere: it signs the sessions and encrypts the admins' authenticator
# secrets and backup codes, so back it up with the database and never
# rotate it without resetting every admin's two-step.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Web client origin, allowed to send cookies. Required in production, unset
# allows every origin in dev. The session cookie is SameSite, so this and
# the API have to share a site (boka.x.se and api.x.se, not two hosts on
# a shared platform domain).
# WEB_ORIGIN=https://boka.example.se
# The reverse proxies in front of the server (a load balancer, a CDN), as
# addresses or CIDR ranges separated by commas, such as 10.0.0.0/8 or
# 172.16.0.5. Their x-forwarded-for names the client, which the sign-in
# attempts are counted per. Leave unset when the server is reached
# directly: the header is then ignored, since anyone can send one.
# TRUSTED_PROXIES=
# Mail: the sign-in codes and welcome mails. Any SMTP service, such as
# Resend, Brevo or SES. Unset in dev sends to Mailpit from docker-compose,
# read at http://localhost:8025. Both are required in production.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Boka <boka@example.se>
