{
  "name": "booking-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "NODE_ENV=development tsx scripts/seed.ts",
    "org:create": "NODE_ENV=${NODE_ENV:-development} tsx scripts/create-organization.ts",
    "push:test": "NODE_ENV=development tsx scripts/push-test.ts",
    "totp": "NODE_ENV=development tsx scripts/totp-code.ts",
    "admin:reset-2fa": "NODE_ENV=${NODE_ENV:-development} tsx scripts/reset-two-factor.ts",
    "types:gen": "NODE_ENV=development tsx scripts/generate-types.ts",
    "types:check": "NODE_ENV=development tsx scripts/generate-types.ts && git diff --exit-code -- openapi.json ../core/src/generated/api.d.ts ../core/src/generated/limits.ts",
    "format": "prettier --write .",
    "test": "export NODE_ENV=test DATABASE_URL=postgresql://postgres:postgres@localhost:5434/booking_test; tsx scripts/reset-test-db.ts && drizzle-kit push --force && node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "check": "prettier --check . && npm run typecheck && npm run types:check"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.4",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "better-auth": "^1.7.4",
    "close-with-grace": "^2.5.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
